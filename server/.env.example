# Database
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# JWT secret 
JWT_SECRET=

# Frontend URL (e.g. http://localhost:3000)
CORS_ALLOWED_ORIGIN=

# Set to true for production HTTPS
COOKIE_SECURE=

# Cookie policy 
COOKIE_SAME_SITE=

# Google Gemini API
GEMINI_API_KEY=
