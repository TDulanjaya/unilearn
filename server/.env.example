# Daily AI limits per student
AI_DAILY_LIMIT_CHAT=50
AI_DAILY_LIMIT_QUIZ=10

# Storj storage
STORJ_KEY_ID=
STORJ_APPLICATION_KEY=
STORJ_ENDPOINT=
STORJ_BUCKET_NAME=
STORJ_REGION=ap1

# Initial super admin
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_PHONE=

